# ==========================================
# 部署示例配置 — 复制为 .env 后填写真实 Key
#   cp .env.example .env
# ==========================================

# 阿里云百炼 DashScope 兼容模式（主题生成 + 文案生成）
DASHSCOPE_API_KEY=你的百炼api_key
LLM_MODEL_NAME=deepseek-v4-pro
FAST_LLM_MODEL_NAME=qwen-turbo

# DeepSeek 官方 API（画像构建专用，快且质量好）
DEEPSEEK_API_KEY=你的deepseek官方api_key
STYLE_MODEL_NAME=deepseek-chat
